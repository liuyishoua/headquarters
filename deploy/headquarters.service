[Unit]
Description=Headquarters business goal control plane
After=network.target channel.service
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/headquarters
ExecStart=/home/ubuntu/leo-project/headquarters/.venv/bin/python -m headquarters --port 8781 --public-origin https://d.58nft.net:9457
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
